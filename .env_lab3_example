# Шаблон переменных ЛР3. НЕ заполняйте этот файл секретами и не коммитьте его
# содержимое с реальными значениями: перенесите ключи в локальный .env.
#
# Все секреты и идентификаторы ниже обязательны: docker-compose.yaml и
# scripts/lab3_bootstrap.sh завершатся ошибкой, если значение пустое или
# содержит CHANGE_ME. Сервисные плейсхолдеры уже соответствуют compose.
# Пароли: не короче 12 символов, уникальные; для OpenSearch — см. ниже.
# LR3_SUPERSET_SECRET_KEY: не короче 32 символов, случайная строка.
# OPENSEARCH_INITIAL_ADMIN_PASSWORD: не короче 8 символов.
# Значения применяются при создании/перезапуске контейнеров; пароль роли БД
# обновляется при каждом запуске lab3-db-init, а пароль пользователя
# OpenMetadata задаётся при первом создании тома.
#
# Существующий том postgres: скрипты /docker-entrypoint-initdb.d повторно не
# выполняются. Если схемы dds нет, примените sql/postgres/init_dds.sql вручную;
# bootstrap создаст витрины и BI-views только после появления DDS.

# --- Airflow (нужны существующему стеку) --------------------------------------
# FERNET_KEY и STEAM_API_KEY уже есть в .env; ниже — обязательный JWT-секрет.
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME_AIRFLOW_JWT_SECRET

# --- Superset -----------------------------------------------------------------
LR3_SUPERSET_DB_USER=lab3_superset
LR3_SUPERSET_DB_NAME=lab3_superset
LR3_SUPERSET_DB_PASSWORD=CHANGE_ME_SUPERSET_DB_PASSWORD
LR3_SUPERSET_SECRET_KEY=CHANGE_ME_RANDOM_LONG_SECRET_KEY
LR3_SUPERSET_ADMIN_USER=lab3_admin
LR3_SUPERSET_ADMIN_PASSWORD=CHANGE_ME_SUPERSET_ADMIN_PASSWORD
LR3_SUPERSET_ADMIN_EMAIL=admin@example.invalid
LR3_SUPERSET_READER_PASSWORD=CHANGE_ME_SUPERSET_READER_PASSWORD

# --- OpenMetadata: метаданные и администратор ---------------------------------
# OM_ADMIN_* — только клиентские учётные данные для ingestion/lineage.
# Серверный пароль администратора OpenMetadata этими переменными автоматически
# не задаётся: проверьте/смените его в UI/API и укажите фактические данные.
LR3_OM_DB_USER=lab3_openmetadata
LR3_OM_DB_NAME=lab3_openmetadata
LR3_OM_DB_PASSWORD=CHANGE_ME_OPENMETADATA_DB_PASSWORD
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=CHANGE_ME_OPENMETADATA_ADMIN_PASSWORD
# OpenSearch: при включённой безопасности нужны 8+ символов, верхний и нижний
# регистр, цифра и спецсимвол. В текущем compose security отключён, но
# bootstrap проверяет сложность, чтобы значение оставалось безопасным.
OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME_OpenSearch_2026!

# --- Сопоставление с lab3/bi и lab3/metadata ----------------------------------
# Отдельного docker-compose.lr3.yml нет: скрипты работают с единым compose,
# поэтому им нужны фактические имена сервисов и адрес API OpenMetadata.
LR3_SUPERSET_SERVICE=superset
SUPERSET_SERVICE=superset
SUPERSET_READER_USER=superset_reader
SUPERSET_DATABASE_NAME=steam-marts
SUPERSET_DASHBOARD_NAME="Steam Analytics (ЛР3)"
SUPERSET_DASHBOARD_SLUG=steam-analytics-lr3
# SUPERSET_UPDATE_EXISTING=0

OM_SERVER_URL=http://openmetadata-server:8585/api
OM_SERVER_SERVICE=openmetadata-server
OM_INGESTION_SERVICE=openmetadata-ingestion
OM_LINEAGE_SERVICE=openmetadata-lineage
OM_POSTGRES_SERVICE=steam-postgres
OM_POSTGRES_HOST=postgres
OM_POSTGRES_PORT=5432
OM_POSTGRES_DB=airflow
OM_POSTGRES_USER=om_reader
OM_POSTGRES_PASSWORD=CHANGE_ME_OM_READER_PASSWORD
OM_WITH_DASHBOARD=1

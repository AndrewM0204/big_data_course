# Шаблон переменных BI-этапа. Реальные значения сюда не коммитить.
# Добавьте их в локальный .env; compose подхватывает .env автоматически.
# Имена LR3_* обязательны для compose; SUPERSET_* — рабочие имена
# контейнера Superset (bootstrap понимает оба варианта).

LR3_SUPERSET_ADMIN_USER=lab3_admin
LR3_SUPERSET_ADMIN_PASSWORD=CHANGE_ME_SUPERSET_ADMIN_PASSWORD
LR3_SUPERSET_READER_PASSWORD=CHANGE_ME_SUPERSET_READER_PASSWORD

# Роль чтения зафиксирована: другое значение SUPERSET_READER_USER отклоняется.
SUPERSET_READER_USER=superset_reader
SUPERSET_SERVICE=superset
SUPERSET_DATABASE_NAME=steam-marts
SUPERSET_DASHBOARD_NAME=Steam Analytics (ЛР3)
SUPERSET_DASHBOARD_SLUG=steam-analytics-lr3
# SUPERSET_URL=http://localhost:8088
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=airflow
# SUPERSET_UPDATE_EXISTING=1

# Шаблон переменных BI-этапа. Реальные значения сюда не коммитить.
# Добавьте их в локальный .env или в отдельный env-файл и укажите LR3_ENV_FILE.
# Пароль администратора Superset уже задаётся инфраструктурой как
# LR3_SUPERSET_ADMIN_USER / LR3_SUPERSET_ADMIN_PASSWORD.

LR3_SUPERSET_READER_PASSWORD=CHANGE_ME_SUPERSET_READER_PASSWORD
LR3_SUPERSET_SERVICE=lr3-superset
SUPERSET_READER_USER=superset_reader
SUPERSET_DATABASE_NAME=steam-marts
SUPERSET_DASHBOARD_NAME=Steam Analytics (ЛР3)
SUPERSET_DASHBOARD_SLUG=steam-analytics-lr3
# SUPERSET_URL=http://localhost:8088
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=airflow
# SUPERSET_UPDATE_EXISTING=0

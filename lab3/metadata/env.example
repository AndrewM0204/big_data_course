# Шаблон переменных metadata-этапа. Реальные значения не коммитить.
# Добавьте их в локальный .env; compose подхватывает .env автоматически.

OM_SERVER_URL=http://openmetadata-server:8585/api
# Стандартные учётные данные OpenMetadata. Для защиты смените их
# одновременно в compose и здесь; compose требует непустой пароль.
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=CHANGE_ME_OM_ADMIN_PASSWORD

OM_POSTGRES_SERVICE=steam-postgres
OM_POSTGRES_HOST=postgres
OM_POSTGRES_PORT=5432
OM_POSTGRES_DB=airflow
# При создании роли (по умолчанию) пользователь должен быть om_reader;
# другая роль допустима только с --no-reader.
OM_POSTGRES_USER=om_reader
OM_POSTGRES_PASSWORD=CHANGE_ME_OM_READER_PASSWORD

OM_SERVER_SERVICE=openmetadata-server
OM_INGESTION_SERVICE=openmetadata-ingestion
OM_LINEAGE_SERVICE=openmetadata-lineage
OM_WITH_DASHBOARD=1

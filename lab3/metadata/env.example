# Шаблон переменных metadata-этапа. Реальные значения не коммитить.
# Добавьте их в локальный .env или отдельный env-файл (LR3_ENV_FILE).

OM_SERVER_URL=http://lr3-openmetadata:8585/api
OM_ADMIN_EMAIL=admin@example.invalid
OM_ADMIN_PASSWORD=CHANGE_ME_OPENMETADATA_ADMIN_PASSWORD

OM_POSTGRES_SERVICE=steam-postgres
OM_POSTGRES_HOST=postgres
OM_POSTGRES_PORT=5432
OM_POSTGRES_DB=airflow
OM_POSTGRES_USER=om_reader
OM_POSTGRES_PASSWORD=CHANGE_ME_OM_READER_PASSWORD

OM_SERVER_SERVICE=lr3-openmetadata
OM_INGESTION_SERVICE=lr3-ingestion
# OM_WITH_DASHBOARD=1
